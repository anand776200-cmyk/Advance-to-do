<% layout('layout/boilerPlate') %>
    <% styles=['login'] %>
        <div class="d-flex col-12 justify-content-center align-items-center" style="height: 100vh; ">

            <form class="p-5 rounded-5 col-3 needs-validation" action="/logIn" method="post"
                style="background-color: rgb(211, 233, 253);" novalidate>
                <div class="mb-3">
                    <label for="exampleInputEmail1" class="form-label">Email address</label>
                    <input type="email" class="form-control" id="exampleInputEmail1" name="email"
                        aria-describedby="emailHelp" required>
                    <div id="emailHelp" class="form-text">We'll never share your email with anyone else.</div>
                    <div class="valid-feedback">
                        Looks good!
                    </div>
                    <div class="invalid-feedback">
                        Please enter a valid Email.
                    </div>
                </div>
                <div class="mb-3">
                    <label for="exampleInputPassword1" class="form-label">Password</label>
                    <input type="password" name="password" class="form-control" id="exampleInputPassword1" required>
                    <div class="valid-feedback">
                        Looks good!
                    </div>
                    <div class="invalid-feedback">
                        Please enter a valid Password.
                    </div>
                </div>
                <div class="d-flex justify-content-between mb-3">
                    <button type="submit" class="btn btn-primary col-5">Submit</button>
                    <a href="/" class="btn btn-success col-5">Go Back..</a>
                </div>
                <div class="d-flex justify-content-center mb-0">
                    <p class="">Dont have an account? <a href="/signIn">sign in</a></p>
                </div>
            </form>
        </div>