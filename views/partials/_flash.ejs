<% if (success && success.length> 0) { %>
    <div class="alert alert-success mt-3 col-5 alert-dismissible fade show d-flex justify-content-center" role="alert">
        <h5>
            <%= success %>
        </h5>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
    <% } %>

        <% if (error && error.length> 0) { %>
            <div class="alert alert-danger mt-3 col-5 alert-dismissible fade show" role="alert">
                <h5>
                    <%= error %>
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>

            </div>
            <% } %>